NEXT_PUBLIC_SITE_URL=https://agsus-pesquisas-nu.vercel.app

# ---------------------------------------------------------------------------
# Banco de dados (schema `sigav`)
#
# Os dados não passam mais pela Data API do Supabase: a aplicação conecta
# direto no PostgreSQL por src/lib/db/rpc-adapter.ts. As 155 funções e as
# policies do banco continuam valendo sem alteração — o adaptador injeta as
# claims em `request.jwt.claims` do mesmo modo que o PostgREST fazia.
#
# Aceita tanto `postgresql://` quanto o formato JDBC `jdbc:postgresql://`.
# Usuário e senha vão separados para que a URL possa ser compartilhada em
# documentação sem carregar credencial.
#
# Para desenvolvimento sem VPN, replique o banco localmente:
#   node --env-file=.env.local scripts/replicar-banco-local.mjs
# e aponte para localhost (ver o próprio script, que imprime os valores).

EMPRESA_DATABASE_URL=
USERNAME_DATABASE_URL=
PASSWORD_DATABASE_URL=

# ---------------------------------------------------------------------------
# Provedor de identidade
#
# `supabase` (padrão, ou variável ausente) — login pelo GoTrue do Supabase.
# `authjs`                                — login pelo Auth.js, que grava a
#   identidade em auth.users/auth.identities pelo mesmo contrato que o banco
#   já espera (ver scripts/auth-identidade-oauth.sql).
#
# Os dois caminhos coexistem no código para que a migração possa ser testada e
# revertida trocando esta variável.

NEXT_PUBLIC_AUTH_PROVIDER=supabase

# Necessárias quando NEXT_PUBLIC_AUTH_PROVIDER=authjs.
#
# AUTH_SECRET assina o cookie de sessão — um valor próprio por ambiente,
# gerado com `openssl rand -base64 32`. AUTH_URL é a origem pública da
# aplicação; precisa bater com o endereço em uso, inclusive a porta.
#
# No Google Cloud Console, em "URIs de redirecionamento autorizados" do cliente
# OAuth, cadastre <AUTH_URL>/api/auth/callback/google. O URI do GoTrue pode
# continuar cadastrado ao lado: os dois coexistem.
#
# AUTH_GOOGLE_HD é opcional e apenas filtra a lista de contas que o Google
# mostra. Quem decide o domínio é sigav.institutional_domains.

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_HD=agenciasus.org.br

# ---------------------------------------------------------------------------
# Supabase — ainda necessário para autenticação (quando o provedor é
# `supabase`) e para o Storage dos buckets `platform-assets`, `survey-assets` e
# `avatars`, que ainda não foram migrados.
#
# As chaves de serviço (SUPABASE_URL, SUPABASE_SECRET_KEY,
# SUPABASE_SERVICE_ROLE_KEY) deixaram de ser usadas quando o acesso a dados
# passou para o PostgreSQL direto: hoje só sobrevivem em
# src/lib/supabase/admin.ts, que não tem mais nenhum importador. Não preencha
# em ambiente novo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Credenciais do cliente OAuth do Google. O mesmo cliente serve aos dois
# provedores de identidade; muda apenas o URI de redirecionamento.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# E-mail e tarefas agendadas

SMTP_USER=
SMTP_APP_PASSWORD=
CRON_SECRET=
