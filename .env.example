NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL da aplicação (schema `sigav`).
# Aceita URL PostgreSQL ou JDBC; usuário e senha podem ser separados.
EMPRESA_DATABASE_URL=
USERNAME_DATABASE_URL=
PASSWORD_DATABASE_URL=

# Opcional quando o ambiente separa o dono do schema da credencial de runtime.
# No db_dataware de desenvolvimento, repita usr_sip_app e a mesma senha.
MIGRATION_USERNAME_DATABASE_URL=
MIGRATION_PASSWORD_DATABASE_URL=

# Use disable somente em servidores confirmados sem TLS, como o ambiente de desenvolvimento atual.
PGSSLMODE=disable

# Autenticação Auth.js / Google OAuth.
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_HD=agenciasus.org.br
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# E-mail e tarefas agendadas.
SMTP_USER=
SMTP_APP_PASSWORD=
CRON_SECRET=
