NEXT_PUBLIC_SITE_URL=https://agsus-pesquisas-nu.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_USER=
SMTP_APP_PASSWORD=
CRON_SECRET=

# --- Control plane de manutenção (Vercel Edge Config) ---
# Production e Preview apontam para stores SEPARADOS, para que exercitar
# manutenção em Preview não possa alterar o estado operacional de produção.
#
# EDGE_CONFIG é a connection string de LEITURA, lida a cada requisição.
# A ESCRITA vai pela API oficial da Vercel e usa VERCEL_API_TOKEN.
#
# Nenhuma destas pode virar NEXT_PUBLIC_*: o token de escrita no navegador
# permitiria a qualquer visitante parar a plataforma.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_TEAM_ID=
VERCEL_API_TOKEN=
